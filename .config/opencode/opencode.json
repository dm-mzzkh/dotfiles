{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-ponytail",
    "opencode-goal-plugin",
    "opencode-notify",
    "@openspoon/subtask2",
    "@tarquinen/opencode-dcp@3.2.0",
    "@atonev/opencode-short-term-memory@1.3.0",
    "opencode-log-sanitizer@1.3.0",
    "opencode-token-tracker@1.7.1",
    "opencode-snip@1.6.1",
    "opencode-update-notifier@0.3.3",
    "@plannotator/opencode@0.27.22",
    "@zenobius/opencode-skillful@1.2.5",
    "opencode-pty@0.4.0",
    "opencode-background-agents@0.1.1",
    "opencode-terminal-bell-notifier@latest",
//    "opencode-damage-control",
//    "opencode-warden"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "agent": {
    "valentino": {
      "prompt": "{file:./personas/valentino.md}",
      "model": "opencode/deepseek-v4-flash-free"
    }
  },
  "lsp": true,
  "mcp": {
    "lenta": {
      "type": "local",
      "command": [
        "/Users/dm/repos/lenta/.mcp-venv/bin/python",
        "/Users/dm/repos/lenta/scripts/mcp_lenta.py"
      ],
      "enabled": false,
      "environment": {
        "LENTA_PROXY_URL": "http://127.0.0.1:8000"
      }
    },
    "postgres": {
      "type": "local",
      "command": [
        "uvx",
        "postgres-mcp",
        "--access-mode=restricted"
      ],
      "enabled": false,
      "environment": {
        "DATABASE_URI": "{env:DATABASE_URI}"
      }
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uvx",
        "arxiv-mcp-server"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp",
        "--browser",
        "firefox",
        "--user-data-dir",
        "/Users/dm/.config/opencode/firefox-profile-copy"
      ],
      "enabled": true
    },
    "google-calendar": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@cocal/google-calendar-mcp"
      ],
      "enabled": false,
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "/Users/dm/.config/opencode/gcp-oauth.keys.json"
      }
    },
    "monica": {
      "type": "local",
      "command": [
        "/run/current-system/sw/bin/node",
        "/Users/dm/repos/black_goo/monica-mcp-queue/dist/index.js"
      ],
      "enabled": false,
      "environment": {
        "MONICA_API_TOKEN": "{env:MONICA_API_TOKEN}",
        "MONICA_BASE_URL": "http://localhost:8081",
        "MCP_HTTP": "false",
        "QUEUE_DB_PATH": "/Users/dm/repos/black_goo/monica-mcp-queue/queue.db"
      }
    }
  },
  "model": "opencode/deepseek-v4-flash-free",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",
      "options": {
        "baseURL": "http://stolas:20128/v1",
        "headers": {
          "Authorization": "Bearer {env:9ROUTER_API_KEY}"
        }
      },
    },
    "local ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3.5:9b-32k": {
          "name": "Qwen3.5 9B (32k ctx, agentic)",
          "limit": {
            "context": 32768,
            "output": 16384
          }
        },
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B (default ctx)",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "lfm2.5:8b": {
          "name": "LFM2.5 8B-A1B MoE (fast agent)",
          "limit": {
            "context": 32768,
            "output": 16384
          }
        }
      }
    },
    "opencode": {
      "name": "OpenCode Zen",
      "api": "openai-completions",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 128000
          }
        }
      }
    },
    "mlx-local": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "AliesTaha/fable-traces": {}
      }
    },
    "mlx-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8083/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "Qwen2.5-Coder-14B-Instruct-4bit": {}
      }
    },
    "bksp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BKSP",
      "options": {
        "baseURL": "https://llm.bksp.in/v1"
      },
      "models": {
        "Gemma-4-31B-it": {
          "name": "Gemma 4 31B-it",
          "limit": {
            "context": 18000,
            "output": 1024
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (Free)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "Authorization": "Bearer {env:OPENROUTER_API_KEY}",
          "HTTP-Referer": "https://opencode.ai",
          "X-Title": "OpenCode"
        }
      },
      "models": {
        "google/gemma-4-31b-it:free": {
          "name": "Gemma 4 31B (Free)",
          "limit": {
            "context": 128000,
            "output": 64000
          }
        },
        "nvidia/nemotron-3-super-120b-a12b:free": {
          "name": "Nemotron 3 Super 120B (Free)",
          "limit": {
            "context": 128000,
            "output": 64000
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "name": "Nemotron 3 Ultra 550B (Free)",
          "limit": {
            "context": 128000,
            "output": 64000
          }
        }
      }
    }
  }
}
