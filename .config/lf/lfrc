map x $$f
map X !$f

# soft delete -> macOS Trash (recoverable). Items the volume can't trash
# (external/network drives without a .Trashes) fall back to an rm -rf prompt.
cmd trash ${{
    set -f
    failed=""
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        trash "$f" || failed="$failed$f
"
    done <<< "$fx"
    if [ -n "$failed" ]; then
        clear
        printf 'Could not move to Trash (volume has no Trash):\n'
        printf '%s' "$failed" | sed 's/^/  /'
        printf 'Permanently delete these with rm -rf? [y/N] '
        read -r ans
        case "$ans" in
            [yY]*) printf '%s' "$failed" | while IFS= read -r f; do
                       [ -n "$f" ] && rm -rf -- "$f"
                   done ;;
        esac
    fi
    lf -remote "send $id unselect"
}}
map D :trash

# permanent delete (rm -rf) with confirmation — irreversible
cmd delete ${{
    set -f
    clear
    printf 'PERMANENTLY delete (rm -rf):\n'
    printf '%s\n' "$fx" | sed 's/^/  /'
    printf 'Are you sure? [y/N] '
    read -r ans
    case "$ans" in
        [yY]|[yY][eE][sS])
            while IFS= read -r f; do
                [ -n "$f" ] && rm -rf -- "$f"
            done <<< "$fx" ;;
    esac
    lf -remote "send $id unselect"
}}
map <delete> :delete


cmd drop ${{
  IFS=$'\n'
  files=($fx)
  blobdrop "${files[@]}"
}}


map B :drop


cmd mkdir %{{
    IFS=" "
    file="$*"
    mkdir -p -- "$file"
    if [ -n "$fs" ]; then
        mv -- $fs "$file"
        lf -remote "send $id unselect"
    fi
}}

map Co :push $mkdir<space>
map Ci :push $touch<space>

# runs in the background via job.sh (formats + extract-into-subdir live there);
# watch progress with `gj`.
cmd extract &{{
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    LF_ID="$id" ~/.config/lf/job.sh extract "${files[@]}"
}}

map Ae :extract

cmd tar &{{
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    LF_ID="$id" ~/.config/lf/job.sh tarball "$1" "${files[@]}"
}}

cmd zip &{{
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    LF_ID="$id" ~/.config/lf/job.sh zipball "$1" "${files[@]}"
}}

# bash/any POSIX shell

cmd z %{{
    result="$(zoxide query --exclude "$PWD" "$@" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

cmd zi ${{
    result="$(zoxide query -i | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

cmd on-cd &{{
    zoxide add "$PWD"
    ~/.config/lf/tabs.sh sync "$id" "$PWD"
    # warm thumbnails for media in this dir so previews are instant (capped)
    n=0
    for f in *; do
        [ -f "$f" ] && ~/.config/lf/scope.sh --prefetch "$f"
        n=$((n + 1)); [ "$n" -ge 30 ] && break
    done
}}

# --- tabs (ranger-style; lf has no native tabs) ---------------------------
cmd on-init &~/.config/lf/tabs.sh sync  "$id" "$PWD"
cmd on-quit &~/.config/lf/tabs.sh clean "$id"
cmd tab-new   &~/.config/lf/tabs.sh new    "$id" "$PWD"
cmd tab-close &~/.config/lf/tabs.sh close  "$id" "$PWD"
cmd tab-next  &~/.config/lf/tabs.sh next   "$id" "$PWD"
cmd tab-prev  &~/.config/lf/tabs.sh prev   "$id" "$PWD"
cmd tab-goto  &~/.config/lf/tabs.sh switch "$id" "$PWD" "$1"

map gn tab-new
map gx tab-close
map <tab> tab-next
map <backtab> tab-prev
map g1 tab-goto 1
map g2 tab-goto 2
map g3 tab-goto 3
map g4 tab-goto 4
map g5 tab-goto 5
map g6 tab-goto 6
map g7 tab-goto 7
map g8 tab-goto 8
map g9 tab-goto 9

cmd find-file ${{
    res="$(fd --type f --hidden --exclude .git | fzf --reverse)" || exit 0
    [ -n "$res" ] && lf -remote "send $id select \"$(printf '%s' "$res" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}
map f find-file


cmd fzf_search ${{
    cmd="rg --column --line-number --no-heading --color=always --smart-case"
    fzf --ansi --disabled --layout=reverse --header="Search in files" --delimiter=: \
        --bind="start:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind="change:reload([ -n {q} ] && $cmd -- {q} || true)" \
        --bind='enter:become(lf -remote "send $id select \"$(printf "%s" {1} | sed '\''s/\\/\\\\/g;s/"/\\"/g'\'')\"")' \
        --preview='bat --color=always --style=plain --highlight-line={2} -- {1}'
#        --preview='~/.config/lf/cleaner.sh; ~/.config/lf/scope.sh {1} "$FZF_PREVIEW_COLUMNS" "$FZF_PREVIEW_LINES" "$FZF_PREVIEW_LEFT" "$FZF_PREVIEW_TOP"'
}}
map gs :fzf_search


cmd follow-link %{{
  lf -remote "send $id select \"$(readlink -- "$f" | sed 's/\\/\\\\/g;s/"/\\"/g')\""
}}

map gL follow-link



# conflict-safe paste with progress. lf's copy/cut buffer lives in this file
# (line 1 = "copy"/"move", rest = paths). rsync --ignore-existing / mv -n never
# clobber; --progress works with macOS' openrsync (no --info=progress2 there).
# p = copy/move, renaming on name clash (folder -> folder_1, folder_2, ...)
cmd paste &{{
    LF_ID="$id" ~/.config/lf/job.sh paste rename
    lf -remote "send $id clear"
}}
map p paste

# P = copy/move, merging into a same-named folder (recursively; source wins on files)
cmd paste-merge &{{
    LF_ID="$id" ~/.config/lf/job.sh paste merge
    lf -remote "send $id clear"
}}
map P paste-merge


cmd rotate ${{
    angle="${1:-90}"
    while IFS= read -r f; do
        magick "$f" -rotate "$angle" "$f"
    done <<< "$fx"
}}

cmd mirror-h &{{
    while IFS= read -r f; do
        magick "$f" -flop "$f"
    done <<< "$fx"
}}

cmd mirror-v &{{
    while IFS= read -r f; do
        magick "$f" -flip "$f"
    done <<< "$fx"
}}

map Ir :rotate
map Imh :mirror-h
map Imv :mirror-v

cmd openwith !{{
    app="$(compgen -c | sort -u | fzf --prompt='Open with: ')"
    [ -z "$app" ] && exit

    while IFS= read -r f; do
        setsid "$app" "$f" >/dev/null 2>&1 &
    done <<< "$fx"
}}

map o :openwith

cmd compress_video &{{
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    LF_ID="$id" ~/.config/lf/job.sh compress "${files[@]}"
}}

map Ic :compress_video

# --- background-jobs popup: watch all running copy/extract/compress at once -
cmd jobs ${{
    if [ -n "${TMUX:-}" ]; then
        tmux display-popup -E -w 70% -h 60% -T " lf jobs " "$HOME/.config/lf/job.sh view"
    else
        "$HOME/.config/lf/job.sh" view
    fi
}}
map gj jobs

# --- smart open: text -> $EDITOR, everything else -> macOS open ------------
# lf only calls `open` for files; the dir guard is a harmless belt-and-braces.
cmd open ${{
    [ -d "$f" ] && { lf -remote "send $id cd \"$f\""; exit; }
    case "$(file -Lb --mime-type -- "$f")" in
        text/*|application/json|application/javascript|*/xml|*/*+xml|inode/x-empty)
            "${EDITOR:-vi}" "$f";;
        video/*) nohup mpv -- "$f" >/dev/null 2>&1 & ;;
        *) open "$f";;
    esac
}}

# --- bulk rename: edit names of the selection (or whole dir) in $EDITOR -----
cmd bulk-rename ${{
    old="$(mktemp)"; new="$(mktemp)"
    if [ -n "$fs" ]; then names="$fs"; else names="$(ls)"; fi
    printf '%s\n' "$names" > "$old"; printf '%s\n' "$names" > "$new"
    "${EDITOR:-vi}" "$new"
    if [ "$(wc -l < "$old")" -ne "$(wc -l < "$new")" ]; then
        rm -f "$old" "$new"; exit
    fi
    paste "$old" "$new" | while IFS="$(printf '\t')" read -r o n; do
        { [ "$o" = "$n" ] || [ -z "$n" ]; } && continue
        [ -e "$n" ] && { printf 'skip (target exists): %s\n' "$n"; continue; }
        mv -- "$o" "$n"
    done
    rm -f "$old" "$new"
    lf -remote "send $id unselect"; lf -remote "send $id reload"
}}
map R bulk-rename

# --- copy / move / symlink the selection into a dir picked via zoxide+fzf ---
cmd cpto ${{
    dest="$(zoxide query -l | fzf --prompt='copy → ')" || exit 0
    [ -d "$dest" ] || exit 0
    while IFS= read -r f; do [ -n "$f" ] && cp -a -- "$f" "$dest"/; done <<< "$fx"
    lf -remote "send $id unselect"
}}
cmd mvto ${{
    dest="$(zoxide query -l | fzf --prompt='move → ')" || exit 0
    [ -d "$dest" ] || exit 0
    while IFS= read -r f; do [ -n "$f" ] && mv -- "$f" "$dest"/; done <<< "$fx"
    lf -remote "send $id unselect"
}}
cmd linkto ${{
    dest="$(zoxide query -l | fzf --prompt='symlink → ')" || exit 0
    [ -d "$dest" ] || exit 0
    while IFS= read -r f; do [ -n "$f" ] && ln -s -- "$f" "$dest"/; done <<< "$fx"
}}
map Mc cpto
map Mm mvto
map Ml linkto

# --- copy path / name / dir to the macOS clipboard -------------------------
cmd yank-path ${{ printf '%s\n' "$fx" | sed '/^$/d' | pbcopy; }}
cmd yank-name ${{ while IFS= read -r p; do [ -n "$p" ] && basename "$p"; done <<< "$fx" | pbcopy; }}
cmd yank-dir  ${{ printf '%s' "$PWD" | pbcopy; }}
map Yp yank-path
map Yn yank-name
map Yd yank-dir

# --- macOS Quick Look (Finder-style peek) and reveal in Finder -------------
cmd quicklook &{{
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    qlmanage -p "${files[@]}" >/dev/null 2>&1
}}
map gp quicklook
cmd reveal &open -R "$f"
map gR reveal

# --- toggle the executable bit on the selection ----------------------------
cmd toggle-exec ${{
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        if [ -x "$f" ]; then chmod -x -- "$f"; else chmod +x -- "$f"; fi
    done <<< "$fx"
    lf -remote "send $id reload"
}}
map gX toggle-exec

# --- disk usage of the selection (lf otherwise shows only dir counts) ------
cmd usage ${{
    clear
    files=(); while IFS= read -r p; do [ -n "$p" ] && files+=("$p"); done <<< "$fx"
    du -sch -- "${files[@]}" 2>/dev/null | sort -h
    printf '\n[enter] '; read -r _
}}
map gu usage

